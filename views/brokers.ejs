<%- include('partials/head') %>

<link rel="stylesheet" href="/css/styles-pages.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/header.css">


<style>
  /* nav{
      margin-top: 90px;
    } */


  .container>p {
    color: var(--pages-text2);
    margin-top: 12px;
    max-width: 560px;
  }

  .badge-gold {
    margin-left: 8px;
        color: var(--darkBlue-to-teal12);
    background: var(--hero-label-bg);
    border: 1px solid var(--hero-label-border);
  }

  .filter-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .filter-btn {
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.84rem;
    font-weight: 600;
    background: var(--pages-bg3);
    border: 1px solid var(--pages-border);
    color: var(--pages-text2);
    transition: all var(--pages-transition);
    cursor: pointer;
  }

  .filter-btn.active,
  .filter-btn:hover {
    background: linear-gradient(135deg, var(--blue-to-teal12), var(--darkBlue-to-sage2));
    color: var(--btn-text);
    box-shadow: var(--shadow-btn-main);
  }

  .broker-row {
    background: var(--pages-card-bg);
    border: 1px solid var(--pages-border);
    border-radius: var(--pages-radius-lg);
    padding: 28px;
    margin-bottom: 16px;
    display: grid;
    grid-template-columns: 60px 1fr auto auto auto auto;
    align-items: center;
    gap: 20px;
    transition: all var(--pages-transition);
  }

  .broker-row:hover {
    border-color: var(--bk-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-bk-hover);
  }

  .broker-logo {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: var(--pages-bg4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--pages-font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--pages-gold);
  }

  .broker-info h3 {
    font-family: var(--pages-font-display);
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .broker-info p {
    font-size: 0.84rem;
    color: var(--pages-text2);
  }

  .broker-stat {
    text-align: center;
  }

  .broker-stat strong {
    display: block;
    font-family: var(--pages-font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .broker-stat span {
    font-size: 0.76rem;
    color: var(--pages-text3);
  }

  .btn-secondary {
    padding: 9px 18px;
    font-size: 0.84rem;
    white-space: nowrap;
    justify-content: center;
  }

  .btn-primary {
    padding: 9px 18px;
    font-size: 0.84rem;
    white-space: nowrap;
  }

  .stars {
    display: flex;
    justify-items: flex-start;
    color: var(--pages-text2);

  }

  .btn-primary-edit {
    background: blue;
  }
  .btn-primary-delete {
    background: red;
    cursor: pointer;
    padding: 11.4px 18px 11.4px 18px;
  }
  .btn-primary-delete>button {
    background: transparent;
    border: none;
    color: white;
    font-size: 0.84rem;
    font-weight: 700;
    box-sizing: content-box;
  }

  @media(max-width:900px) {
    .broker-row {
      grid-template-columns: 1fr;
    }
  }

  .compare-brokers {
    text-align: center;
    margin-top: 40px;
  }
</style>
</head>

<body>
  <%- include('partials/header') %>



  <div class="page-wrapper">
    <div class="page-header">
      <div class="container">
        <div class="breadcrumb"><a href="/">Home</a><span>/</span><span>Brokers</span></div>

        <span class="section-label">
          <div class="ld">✦</div>
          Broker Reviews
        </span>
        <h1>Top Rated <span class="text-gold">Forex Brokers</span></h1>
        <p>Hand-picked, independently reviewed, and ranked for your trading success. Updated monthly by our expert team.
        </p>
      </div>
    </div>

    <section class="section"> 
  <div class="container"> 
    <div class="filter-bar"> 
      <button class="filter-btn active" onclick="filterBrokers(this,'all')">All Brokers</button> 
      <button class="filter-btn" onclick="filterBrokers(this,'ecn')">ECN Brokers</button> 
      <button class="filter-btn" onclick="filterBrokers(this,'standard')">Standard</button> 
      <button class="filter-btn" onclick="filterBrokers(this,'crypto')">Crypto Friendly</button> 
      <button class="filter-btn" onclick="filterBrokers(this,'low-deposit')">Low Deposit</button> 
      <button class="filter-btn" onclick="filterBrokers(this,'welcome-bonus')">Welcome Bonus</button> 
    </div> 

    <% 
      // 1. Create a safe copy and sort it (Top Pick > Editor's Pick > Rest)
      const sortedBrokers = typeof editAddBroker !== 'undefined' && Array.isArray(editAddBroker) 
        ? [...editAddBroker].sort((a, b) => {
            const pickA = (a.brokerPick || '').trim().toUpperCase();
            const pickB = (b.brokerPick || '').trim().toUpperCase();

            const getWeight = (pickString) => {
              if (pickString === 'TOP PICK') return 3;
              if (pickString === "EDITOR'S PICK" || pickString === "EDITOR’S PICK") return 2;
              return 1; 
            };

            return getWeight(pickB) - getWeight(pickA);
          })
        : [];
    %>

    <!-- 2. Changed loop target from editAddBroker to sortedBrokers -->
    <% sortedBrokers.forEach(broker => { %> 
      <div id="broker-list"> 
        <!-- Broker 1 --> 
        <input hidden class="brokerId" type="text" value="<%= broker.id %>"> 
        <div class="broker-row" data-tags="<%= Array.isArray(broker.brokerDataTags) ? broker.brokerDataTags.join(' ') : '' %>"> 
          <div class="broker-logo"><%= broker.brokerLogo %></div> 
          <div class="broker-info"> 
            <h3>
              <%= broker.brokerName %> 
              <!-- Only show badge if the broker has one -->
              <% if (broker.brokerPick && broker.brokerPick.trim() !== '') { %>
                <span class="badge badge-gold"><%= broker.brokerPick %></span>
              <% } %>
            </h3> 
            <div hidden class="broker-rating" data-rating="<%= broker.brokerRating %>"></div> 
            <div class="stars rating-stars"> 
              <span class="star">★</span> 
              <span class="star">★</span> 
              <span class="star">★</span> 
              <span class="star">★</span> 
              <span class="star">★</span> 
              </div> 
              <p><%= broker.brokerHeading %></p> 
              <div class="tags"> 
                <% if (Array.isArray(broker.brokerTags)) { %>
                  <% broker.brokerTags.forEach(tag => { %> 
                    <span class="tag"><%= tag %></span> 
                  <% }) %> 
                <% } %>
              </div> 
            </div> 
            <div class="broker-stat"><strong class="text-gold"><%= broker.brokerLeverage %></strong><span>Max Leverage</span></div> 
            <div class="broker-stat"><strong>$<%= broker.brokerMinDeposit %></strong><span>Min Deposit</span> </div> 
            <div class="broker-stat"><strong class="text-green"><%= broker.brokerMinSpread %></strong><span>Min Spread</span></div> 
            <div class="pages-openAccount"> 
              <a href="/broker-review/<%= broker.id %>" class="btn-secondary">Read Review</a> 
              <a href="/open-account" class="btn-primary">Open Account</a> 
              <form class="btn-primary-delete btn-primary" action="/admin/delete-broker/<%= broker.id %>" method="POST"> 
                <button type="submit" onclick="return confirm('Are you sure you want to delete this broker?')"> Delete Broker </button> 
              </form> 
              <a href="/admin/edit-broker/<%= broker.id %>?editing=true" class="btn-primary-edit btn-primary">Edit Broker</a> 
            </div> 
          </div> 
        <% }) %> 

        <div class="compare-brokers"> 
          <a href="/compare-brokers" class="btn-primary">📊 Compare All Brokers Side-by-Side</a> 
        </div> 
      </div> 
  </div>
</section>

  </div>


  <%- include('partials/footer') %>

  <script>
    function filterBrokers(btn, tag) {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.broker-row').forEach(row => {
        if (tag === 'all' || row.dataset.tags?.includes(tag)) {
          row.style.display = 'grid';
        } else {
          row.style.display = 'none';
        }
      });
    }
    let abc = `<%- include('partials/theme-home-btn') %>`;
    console.log('theme is', abc)



    // MY LOGIC ::::::::::::::::::::::::::::::::::::::::::
    // :::::::::::::::::::::::: FINAL RESOLVED LOGIC ::::::::::::::::::::::::

    // 1. Find all hidden inputs/elements with the class '.brokerId' on the page and loop through each one
    document.querySelectorAll('.brokerId').forEach(broker => {

      // Log the adjacent element container (the container right next to our ID input) to verify DOM tracking
      console.log('Next sibling container:', broker.nextElementSibling);

      // 2. Look INSIDE this specific broker's next sibling container to find ONLY its 5 star elements
      // This isolates our star search so we never accidentally touch another broker's stars
      let ratingStars = broker.nextElementSibling.querySelectorAll('.rating-stars span');

      // 3. Find the element holding the rating data attribute INSIDE this broker's specific container
      // RESOLVED BUG: Changed from '#' (ID) to '.' (Class) to prevent duplicate ID selector bugs on the page
      let brokerRatingElement = broker.nextElementSibling.querySelector('.broker-rating');

      // Read the rating string value out of the 'data-rating' attribute on that element
      let rating = brokerRatingElement.dataset.rating;

      // Debug logs to verify we have the right data and strings in the browser console
      console.log('Current broker data rating string:', rating);
      console.log('Type of rating variable:', typeof rating);
      console.log('Target stars for this broker:', ratingStars);

      // 4. Convert the rating string to a number and loop through our star index count (up to max rating)
      for (let i = 0; i < Number(rating); i++) {

        // Check if the overall rating is a clean whole integer (e.g., 4 or 5)
        // The '+' shorthand converts the string 'rating' into a number before checking
        if (Number.isInteger(+rating)) {
          console.log('The rating number is a whole integer:', rating);

          // Add the full-star styling class to the star at the current loop index 'i'
          ratingStars[i].classList.add('full-filled-star');

        } else {
          // If the number contains decimals (e.g., 0.6 or 4.5), execute this fallback branch
          console.log('The rating number is a decimal/fraction:', rating);

          // First, provisionally light up the star at index 'i' fully
          ratingStars[i].classList.add('full-filled-star');

          // 5. Evaluate if the remaining fractional value is less than 1 
          // Example: If rating is 0.6 and i = 0 -> (0.6 - 0) = 0.6. This is < 1, meaning this star is the fraction!
          if (Number(rating) - i < 1) {
            // Swap out the full-star style for the half-filled style on this final index
            ratingStars[i].classList.replace('full-filled-star', 'half-filled-star');
            console.log('Star index matches the decimal remainder. Styled as half-filled.');
          }
        }
      }
    });



    document.querySelectorAll('.badge-gold').forEach(badge => {
      if (badge.textContent.trim() === '') {
        badge.style.display = 'none';
      }
    });
  </script>
  <script src="/js/theme.js"></script>

  <script src="/js/script.js"></script>
</body>

</html>