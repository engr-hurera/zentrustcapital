<%- include('partials/head') %>

<link rel="stylesheet" href="/css/styles-pages.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/header.css">

<style>
  .legal-body {
    max-width: 760px;
    margin: 0 auto;
  }

  .legal-body h3 {
    font-family: var(--pages-font-display);
    margin: 36px 0 12px;
    color: var(--darkBlue-to-teal12);
    font-size: 1.1rem;
  }

  .legal-body p {
    color: var(--pages-text2);
    margin-bottom: 14px;
    font-size: 0.93rem;
    line-height: 1.8;
  }

  .legal-body ul {
    margin: 0 0 16px 20px;
    color: var(--pages-text2);
    font-size: 0.93rem;
    line-height: 1.9;
  }

  .last-updated {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--pages-bg3);
    border: 1px solid var(--pages-border);
    border-radius: 50px;
    padding: 5px 14px;
    font-size: 0.8rem;
    color: var(--pages-text3);
    margin-bottom: 32px;
  }

  .warning-box {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--pages-radius);
    padding: 20px 24px;
    margin: 28px 0;
  }

  .warning-box p {
    color: var(--pages-text);
    margin: 0;
    font-size: 0.9rem;
  }
</style>
</head>

<body>
  <%- include('partials/header') %>
  <h1>Page Not Found</h1>

  <script src="/js/theme.js"></script>
  <script src="/js/script.js"></script>
  <script src="/js/emailWhatsAppRedirect.js"></script>

</body>

</html>