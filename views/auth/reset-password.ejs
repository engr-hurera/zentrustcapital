<%- include('../partials/head') %>

<link rel="stylesheet" href="/css/styles-pages.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/header.css">

<style>

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-container {
    width: 100%;
    max-width: 440px;
    margin: 75px auto 0;
    padding: 24px;
  }

  .auth-card {
    background: var(--pages-card-bg);
    border: 1px solid var(--pages-border);
    border-radius: var(--pages-radius-lg);
    padding: 40px;
  }

  .auth-title {
    font-family: var(--pages-font-display);
    font-size: 1.6rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 8px;
  }

  .auth-sub {
    color: var(--pages-text2);
    font-size: 0.88rem;
    text-align: center;
    margin-bottom: 28px;
    line-height: 1.5;
  }

  .message {
    margin-bottom: 18px;
    padding: 12px;
    border-radius: 8px;
    background: rgba(220, 38, 38, 0.1);
    color: #dc2626;
    font-size: 0.85rem;
    text-align: center;
  }

  .back-link {
    display: block;
    text-align: center;
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--darkBlue-to-teal12);
  }

  .privacy-text {
    text-align: center;
    font-size: 0.76rem;
    color: var(--pages-text3);
    margin-top: 20px;
  }

  .privacy-link {
    color: var(--darkBlue-to-teal12);
  }

  nav.main,
  .btn-ghost,
  #btt,
  footer,
  .risk-note {
    display: none;
  }

</style>

</head>

<body>

<%- include('../partials/header') %>

<div class="auth-container">

  <div class="auth-card">

    <div class="auth-title">
      Reset Password
    </div>

    <div class="auth-sub">
      Create a new secure password for your account.
    </div>


    <% if (locals.error) { %>

      <div class="message">
        <%= error %>
      </div>

    <% } %>


    <% if (token) { %>

      <form
        action="/reset-password/<%= token %>"
        method="POST"
      >

        <div class="form-group">

          <label class="form-label">
            New Password
          </label>

          <input
            type="password"
            name="password"
            class="form-input"
            placeholder="Enter your new password"
            autocomplete="new-password"
            required
          >

        </div>


        <div class="form-group">

          <label class="form-label">
            Confirm New Password
          </label>

          <input
            type="password"
            name="confirm_password"
            class="form-input"
            placeholder="Confirm your new password"
            autocomplete="new-password"
            required
          >

        </div>


        <button
          type="submit"
          class="btn-primary w-full"
        >
          Reset Password →
        </button>

      </form>

    <% } %>


    <a
      href="/login"
      class="back-link"
    >
      ← Back to Login
    </a>

  </div>


  <p class="privacy-text">

    Protected by 256-bit SSL encryption.

    <a
      class="privacy-link"
      href="/privacy"
    >
      Privacy Policy
    </a>

  </p>

</div>


<script src="/js/theme.js"></script>
<script src="/js/script.js"></script>

</body>

</html>